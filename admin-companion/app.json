{
  "expo": {
    "name": "Prestige Limo Ops",
    "slug": "prestige-admin",
    "owner": "prestige-limo-ops",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "prestige-admin",
    "icon": "./assets/app-icon.png",
    "platforms": [
      "ios"
    ],
    "ios": {
      "version": "1.0.0",
      "supportsTablet": false,
      "bundleIdentifier": "sg.prestigelimo.admin",
      "buildNumber": "1",
      "icon": "./assets/app-icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "Prestige Limo Ops",
        "NSFaceIDUsageDescription": "Allow Prestige Limo Ops to use Face ID to protect verified operations access."
      }
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Prestige Limo Ops to use Face ID to protect verified operations access."
        }
      ],
      "expo-secure-store"
    ]
  }
}
