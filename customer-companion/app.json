{
  "expo": {
    "name": "Prestige SG",
    "slug": "prestige-customer",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "scheme": "prestige-customer",
    "platforms": [
      "ios"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "sg.prestigelimo.customer",
      "buildNumber": "7",
      "associatedDomains": [
        "applinks:app.prestigelimo.sg"
      ],
      "icon": "./assets/app-icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "Prestige SG",
        "NSFaceIDUsageDescription": "Allow Prestige SG to use Face ID to protect your booking information."
      }
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Prestige SG to use Face ID to protect your booking information."
        }
      ],
      "expo-secure-store"
      ,
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "ce71ff91-7f71-4297-bcef-edf420f94316"
      }
    },
    "owner": "prestige-limo-ops"
  }
}
