{
  "expo": {
    "name": "Prestige SG Driver",
    "slug": "prestige-driver-companion",
    "owner": "prestige-limo-ops",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "version": "1.0.0",
      "supportsTablet": true,
      "bundleIdentifier": "sg.prestigelimo.drivercompanion",
      "buildNumber": "4",
      "icon": "./assets/icon.png",
      "associatedDomains": [
        "applinks:app.prestigelimo.sg"
      ],
      "infoPlist": {
        "CFBundleDisplayName": "Prestige Driver",
        "NSCameraUsageDescription": "Prestige uses the camera only when you choose to attach the required OTS proof photo.",
        "NSPhotoLibraryUsageDescription": "Prestige accesses a photo only when you choose it for the required OTS proof."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "sg.prestigelimo.drivercompanion",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "host": "app.prestigelimo.sg",
              "pathPrefix": "/driver-job/",
              "scheme": "https"
            }
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Prestige uses your location only after you start tracking for an assigned job.",
          "locationAlwaysAndWhenInUsePermission": "Prestige uses your location while trip tracking is active, including when this app is in the background or the screen is locked.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-web-browser",
      "./plugins/with-driver-camera-query"
    ],
    "extra": {
      "eas": {
        "projectId": "2a797181-d09d-4384-8d01-583456e83c3e"
      }
    }
  }
}
